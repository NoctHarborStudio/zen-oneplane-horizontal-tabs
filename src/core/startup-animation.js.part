    window.addEventListener("resize",onResize);
    window.addEventListener("OnePlane:StartupState",schedule);
    prefs.addObserver("zen.nocturne.motion.enabled",preferenceChanged);
    prefs.addObserver(ENABLE,preferenceChanged);
