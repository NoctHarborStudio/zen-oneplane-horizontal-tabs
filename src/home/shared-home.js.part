    win.__nocturneTrace?.("home.search."+event,fields,{sample:800});
  }
  // A card starts appearing when any of its height is uncovered, rather
  // than waiting for the top of the entire Pinned section to clear.
  function returnCardState(top,height,bottom,progress,finalBottom){
    const clamp=v=>Math.max(0,Math.min(1,v)),smooth=v=>{const t=clamp(v);return t*t*(3-2*t);};
    const h=Math.max(1,height),p=clamp(progress);
    const overlap=Math.max(0,bottom-top+3)-Math.max(0,finalBottom-top+3);
    const clip=Math.min(h,Math.max(0,overlap));
    const exposed=h-clip;
    const alpha=smooth(exposed/Math.min(h,38))*smooth(p/.48);
    return {alpha,clip,shift:6*(1-alpha)};
  }
  function prepareReturnParts(){
    // Measure all visible cards and headings once. Rows at equal y share
    // the same reveal timing automatically, including wrapped workspaces.
    const bounds=panel.getBoundingClientRect();
    const parts=[];
    for(const node of content.querySelectorAll(".zh-section h3,.zh-pin,.zh-pins .zh-empty,.zh-editbar,.zh-space,.zh-footer")){
      const rect=node.getBoundingClientRect();
      if(rect.height<=0||rect.bottom<=bounds.top||rect.top>=bounds.bottom)continue;
      // Footer itself is hidden by data-zh-search; its resting opacity is 1.
      const base=node.classList.contains("zh-footer")?1:Number.parseFloat(win.getComputedStyle(node).opacity);
      parts.push({node,top:rect.top,height:rect.height,base:Number.isFinite(base)?base:1,last:null});
    }
    return parts;
  }
  function paintReturnParts(parts,bottom,progress,finalBottom){
    for(const part of parts){
      const state=returnCardState(part.top,part.height,bottom,progress,finalBottom);
      const alpha=state.alpha.toFixed(3),clip=state.clip.toFixed(2)+"px",shift=state.shift.toFixed(2)+"px";
      const key=alpha+"/"+clip+"/"+shift;if(part.last===key)continue;part.last=key;
      part.node.style.setProperty("--zh-return-alpha",alpha);
      part.node.style.setProperty("--zh-return-clip",clip);
      part.node.style.setProperty("--zh-return-shift",shift);
    }
  }
  // The floating Zen popover is in the top layer, so a background press
  // need not reach the panel itself. Only claim an actual Home background
  // or the popover's own retargeted outside press; never a result/control.
  function isHomeSearchBackgroundPress(event,home,body,bar,host,panels){
    if(event.defaultPrevented||event.button!==0||event.isPrimary===false||
       !body.hasAttribute("inert")||bar.hasAttribute("has-popup-open"))return false;
    const target=event.target;
    if(!target)return false;
    const direct=target===home||target===body||body.contains?.(target);
    const passive=target===host||target===panels;
    const backdrop=target===bar&&bar.matches?.(":popover-open");
    if(!direct&&!passive&&!backdrop)return false;
    // Coordinates are CSS viewport pixels, like getBoundingClientRect().
    // Reject anonymous retargets in the live editor and outside Home.
    const x=event.clientX,y=event.clientY;
    if(!Number.isFinite(x)||!Number.isFinite(y))return false;
    const contains=rect=>rect&&x>=rect.left&&x<rect.right&&y>=rect.top&&y<rect.bottom;
    return contains(home.getBoundingClientRect())&&!contains(bar.getBoundingClientRect());
  }
  function onSearchPointerDown(event){
    if(!open||!searchToken||!searchBar||(searchClosing&&!searchToken.liveReturn))return;
    const bar=searchBar,target=event.target,id=searchToken.homeProbe?.id??null;
    // The Address shield owns the complete pointer sequence. It delegates
    // cancellation through the Home lease on click (or its existing fallback).
    // Never intercept its pointerdown or duplicate its native close.
    if(target===doc.getElementById("oneplane-url-dismiss")){
      win.__nocturneTrace?.("home.search.pointer-boundary",{id,shield:true,background:true,consumed:false});
      return;
    }
    const background=isHomeSearchBackgroundPress(event,panel,content,bar,host,panels);
    if(!background&&searchToken.liveReturn?.phase==="fold"&&bar.contains?.(target)&&event.button===0&&event.isPrimary!==false&&!event.defaultPrevented){
      const rect=bar.getBoundingClientRect();
      if(event.clientX>=rect.left&&event.clientX<rect.right&&event.clientY>=rect.top&&event.clientY<rect.bottom)reverseLiveSearch();
    }
    const consumed=background&&(searchClosing||cancelHomeSearch("home-background"));
    // One bounded, structural record per press, without coordinates, node
    // identifiers, input or result data. Explains missed native handoffs.
    win.__nocturneTrace?.("home.search.pointer-boundary",()=>({
      id,background,consumed,home:target===panel||target===content||content.contains?.(target),
      host:target===host,panels:target===panels,bar:target===bar,
      barChild:target!==bar&&bar.contains?.(target),primary:event.button===0&&event.isPrimary!==false
    }));
    if(consumed){
