      const spaces=html("section","zh-section"),list=html("div","zh-spaces");spaces.append(html("h3","","Workspaces"),list);
      let workspaces=[];try{workspaces=manager.getWorkspaces()||[];}catch{}
      for(const ws of workspaces){
