  function reverseLiveSearch(){
    const token=searchToken,state=token?.liveReturn;
    if(state?.phase!=="fold")return false;
    try{return driveLiveSearch(token,state,false,"escape");}
    catch(error){win.console.warn("[Zen Home] live search reverse",nocturneErrorClass(error));settleLiveSearch();return false;}
  }
  function cancelHomeSearch(reason="escape"){
    const token=searchToken,bar=searchBar;
    if(!token||!bar||!searchGeometry||searchClosing||!ownsLiveSearch(token,bar))return false;
    if(!prefs.getBoolPref("zen.nocturne.motion.enabled",true))return false;
    try{
      let state=token.liveReturn;
      if(!state){
        const height=bar.getBoundingClientRect().height;
        state=token.liveReturn={phase:"fold",progress:0,fullHeight:Math.max(height,searchLastHeight),started:false};
        finishSearchProbe(token,"open","interrupted");
        searchReturnParts=prepareReturnParts();
        for(const part of searchReturnParts)part.node.style.setProperty("--zh-return-base",String(part.base));
        for(const node of content.querySelectorAll("[data-zh-enter]"))node.removeAttribute("data-zh-enter");
        panel.setAttribute("data-zh-search-ready","");panel.setAttribute("data-zh-return","");
      }
      return driveLiveSearch(token,state,true,reason);
    }catch(error){
      win.console.warn("[Zen Home] live search cancel",nocturneErrorClass(error));
