    try{
      bar._zenHandleUrlbarClose(false,false);
      // A native callback may synchronously start a different session.
      if(!nativeSearchReplaced(token,bar))bar.blur?.();
      return true;
    }catch(error){win.console.warn("[Zen Home] search cancel",nocturneErrorClass(error));finishSearchVisual();return false;}
  }
  // Only Home-owned, still-live Zen sessions may defer native cancellation.
  function ownsLiveSearch(token,bar){
    return ownsNativeSearch(token,bar)&&liveSearchReady(bar);
  }
  function clearLiveReturnParts(){
    for(const part of searchReturnParts)for(const key of ["alpha","base","clip","shift"])part.node.style.removeProperty("--zh-return-"+key);
    searchReturnParts=[];panel.removeAttribute("data-zh-return");
  }
  function settleLiveSearch(focus=false){
    finishSearchVisual();
    if(focus&&open)content.querySelector(".zh-search")?.focus({preventScroll:true});
  }
  function driveLiveSearch(token,state,closing,reason){
    const bar=searchBar,g=searchGeometry,header=g.header;
    if(!ownsLiveSearch(token,bar))return false;
    const from=Math.max(header,Math.min(g.room,bar.getBoundingClientRect().height||header));
    const target=closing?header:Math.max(header,naturalSearchHeight(bar,g));
    const view=bar.querySelector(".urlbarView");
    const value=Number.parseFloat(win.getComputedStyle(view||bar).opacity);
    const fromAlpha=Math.max(0,Math.min(1,Number.isFinite(value)?value:1));
    const fromProgress=state.progress;
    const duration=closing?(from>header+8?368:144):448;
    const distance=Math.abs(target-from),full=Math.max(1,state.fullHeight-header,target-header,from-header);
    const time=Math.max(1,Math.round(duration*Math.min(1,distance/full)));
    const ms=state.started?time:duration;state.started=true;
    state.phase=closing?"fold":"reverse";searchClosing=closing;
    if(closing){
      beginSearchCloseProbe(token);
      searchLog("close-start",{id:token.homeProbe?.id??null,reason,mode:"native-live",rows:view?.querySelectorAll(".urlbarView-row:not([hidden])").length||0,height:Math.round(from),header:Math.round(header),duration:ms});
    }else{
      finishSearchProbe(token,"close","interrupted");if(token.homeProbe)token.homeProbe.close=null;
      searchLog("close-reverse",{id:token.homeProbe?.id??null,mode:"native-live",height:Math.round(from),duration:ms});
    }
