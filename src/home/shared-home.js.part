  function animateSearchHeight(token,from,to,duration,closing,done,live=null){
    if(searchFrame)win.cancelAnimationFrame(searchFrame);
    searchFrame=0;
    const bar=searchBar;if(!bar)return;
    bar.setAttribute("data-zr-home-search-motion","run");
    const header=searchGeometry?.header||56;
    const alpha=h=>Math.min(1,Math.max(0,(h-header)/Math.max(120,Math.abs(to-from)*.55)));
    paintSearchHeight(bar,from,live?live.alpha(from,0):alpha(from));
    live?.paint(from,0);
    let start=null;
    const tick=now=>{
      searchFrame=0;
      if(!open||searchToken!==token||searchBar!==bar||searchClosing!==closing)return;
      if(live&&!live.valid()){live.invalid();return;}
      if(!live&&token.nativeClose&&!ownsNativeSearch(token,bar)){settleNativeSearch("live-invalid");return;}
      if(start===null)start=now;
