          if(other!==window&&!other.closed&&other.gZenWorkspaces?.getWorkspaceFromId?.(id))return null;
        }
        if(tabs.some(t=>t.closing||t.group||t.hasAttribute("glance-id")||t.hasAttribute("zen-glance-tab")||
