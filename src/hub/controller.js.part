    let trashOpen=false,purgePlan=null,trashDrag=null,editId=null;
    let trashData=[],trashAllowed=false,trashAgeTimer=0,trashFrame=0,trashRangeKey="",trashTarget=null;
    let trashAge="all";
    const TRASH_ROW_HEIGHT=54;
