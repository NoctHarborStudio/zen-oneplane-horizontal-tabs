        {clipPath:"inset(0 0 100% 0 round 8px)",opacity:0,translate:"0 -6px"}:
        {clipPath:"inset(0 0 0% 0 round 8px)",opacity:1,translate:"0 0px"};
      stopMotion();
      const to=show?{clipPath:"inset(0 0 0% 0 round 8px)",opacity:1,translate:"0 0px"}:
