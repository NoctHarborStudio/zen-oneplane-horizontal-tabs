    /* Opening hides one whole strip, without per-card animation or
       changing layout. Bookmarks and other toolbar zones are untouched. */
    #oneplane-tabs[data-op-cascade] { pointer-events:none !important; }
    #oneplane-tabs[data-op-cascade="hidden"] {
      visibility:hidden !important;
      opacity:0 !important;
    }
    #oneplane-tabs[data-op-cascade] :is(.oneplane-tab,.oneplane-split-handle,.oneplane-title-island,.oneplane-new-tab,#oneplane-tab-indicator,.oneplane-tab-list,.oneplane-split-group) {
      transition:none !important;
      pointer-events:none !important;
    }
    #oneplane-tabs[data-op-cascade="showing"] :is(.oneplane-tab,.oneplane-split-handle,.oneplane-title-island,.oneplane-new-tab,#oneplane-tab-indicator):not([data-op-cascade-member]),
    #oneplane-tabs[data-op-cascade="showing"] .oneplane-split-group:not([data-op-cascade-frame]) {
      opacity:0 !important;
    }

