    /* A fixed slot remains in layout. Only paint geometry moves. */
    #oneplane-tabs[data-op-cascade] { pointer-events: none !important; }
    #oneplane-tabs[data-op-cascade]:not([data-op-cascade="settling"]) :is(.oneplane-tab,.oneplane-split-handle,.oneplane-title-island,.oneplane-new-tab,#oneplane-tab-indicator,.oneplane-tab-list) {
      transform-origin: center;
      transition: none !important;
      pointer-events: none !important;
    }
    #oneplane-tabs[data-op-cascade]:not([data-op-cascade="settling"]) :is(.oneplane-tab,.oneplane-split-handle,.oneplane-title-island,.oneplane-new-tab,#oneplane-tab-indicator):not([data-op-cascade-member]) {
      opacity: 0 !important;
    }
    #oneplane-tabs[data-op-cascade] #oneplane-tab-indicator { opacity:0 !important; }
    #oneplane-tabs [data-op-cascade-frozen].oneplane-tab {
      width:var(--op-cascade-width) !important;
      flex-basis:var(--op-cascade-width) !important;
    }
    /* Match Island Mode's more specific plus positioning. WAAPI still
       owns translate during the cascade; this is only its base value. */
    #oneplane-tabs[data-op-cascade] [data-op-cascade-frozen]:is(.oneplane-tab-list,.oneplane-new-tab),
    #oneplane-tabs[data-op-show-island][data-op-cascade]:not([data-op-island-tight]) .oneplane-new-tab[data-op-cascade-frozen] {
      translate:var(--op-cascade-translate);
    }
    /* The original split surface remains the only surface. */
    #oneplane-tabs[data-op-cascade]:not([data-op-cascade="settling"]) .oneplane-split-group {
      transition:none !important;
      --op-cascade-frame-alpha:0;
    }
    #oneplane-tabs[data-op-cascade]:not([data-op-cascade="settling"]) .oneplane-split-group[data-op-cascade-frame] {
      --op-cascade-frame-alpha:1;
    }

