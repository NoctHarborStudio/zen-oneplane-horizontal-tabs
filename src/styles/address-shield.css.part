    /* The web page cannot receive the pointer sequence used to dismiss search. */
    #zen-tabbox-wrapper { position: relative !important; }
    #zen-appcontent-navbar-wrapper { z-index: 5 !important; }
    #oneplane-url-dismiss {
      position: absolute !important;
      inset: 0 !important;
      z-index: 100 !important;
      background: transparent !important;
      pointer-events: auto !important;
      touch-action: none;
      user-select: none;
      cursor: default;
    }
    &:has(#urlbar[focused="true"], #urlbar[open]) #oneplane-url-dismiss,
    #oneplane-url-dismiss[data-pressed] { display: block !important; }

