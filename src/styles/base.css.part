    --nocturne-home-search-paint: color-mix(in srgb, var(--nocturne-glass-tint) var(--nocturne-home-search-opacity), transparent);
    --nocturne-hub-opacity: var(--nocturne-glass-opacity);
    @media (-moz-pref("zen.nocturne.material.hub.opacity", 0)) { --nocturne-hub-opacity: 0%; }
