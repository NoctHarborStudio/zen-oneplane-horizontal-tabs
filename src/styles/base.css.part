    @media (-moz-pref("zen.nocturne.material.hub.opacity", 20)) { --nocturne-hub-opacity: 20%; }
    @media (-moz-pref("zen.nocturne.material.hub.opacity", 30)) { --nocturne-hub-opacity: 30%; }
    @media (-moz-pref("zen.nocturne.material.hub.opacity", 40)) { --nocturne-hub-opacity: 40%; }
    @media (-moz-pref("zen.nocturne.material.hub.opacity", 50)) { --nocturne-hub-opacity: 50%; }
    @media (-moz-pref("zen.nocturne.material.hub.opacity", 60)) { --nocturne-hub-opacity: 60%; }
    @media (-moz-pref("zen.nocturne.material.hub.opacity", 70)) { --nocturne-hub-opacity: 70%; }
    @media (-moz-pref("zen.nocturne.material.hub.opacity", 80)) { --nocturne-hub-opacity: 80%; }
    @media (-moz-pref("zen.nocturne.material.hub.opacity", 90)) { --nocturne-hub-opacity: 90%; }
    @media (-moz-pref("zen.nocturne.material.hub.opacity", 100)) { --nocturne-hub-opacity: 100%; }
    --nocturne-hub-blur: var(--nocturne-glass-blur);
    @media (-moz-pref("zen.nocturne.material.hub.blur", 0)) { --nocturne-hub-blur: 0px; }
    @media (-moz-pref("zen.nocturne.material.hub.blur", 8)) { --nocturne-hub-blur: 8px; }
    @media (-moz-pref("zen.nocturne.material.hub.blur", 12)) { --nocturne-hub-blur: 12px; }
