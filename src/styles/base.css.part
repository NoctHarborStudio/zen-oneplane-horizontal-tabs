    @media (-moz-pref("zen.nocturne.material.home-search.opacity", 30)) { --nocturne-home-search-opacity: 30%; }
    @media (-moz-pref("zen.nocturne.material.home-search.opacity", 40)) { --nocturne-home-search-opacity: 40%; }
    @media (-moz-pref("zen.nocturne.material.home-search.opacity", 50)) { --nocturne-home-search-opacity: 50%; }
    @media (-moz-pref("zen.nocturne.material.home-search.opacity", 60)) { --nocturne-home-search-opacity: 60%; }
    @media (-moz-pref("zen.nocturne.material.home-search.opacity", 70)) { --nocturne-home-search-opacity: 70%; }
