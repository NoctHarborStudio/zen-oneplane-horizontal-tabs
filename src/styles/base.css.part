      --nocturne-home-search-opacity: 100%;
      --nocturne-address-blur: 0px;
      --nocturne-home-search-blur: 0px;
    }
    @media (forced-colors: active) {
      --nocturne-hub-paint: Canvas;
      --nocturne-downloads-paint: Canvas;
