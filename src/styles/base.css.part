}
/* Experimental Home-only direct alpha: clear native opaque chrome backing,
   retain the original Zen gradient/grain as a single adjustable tint.
   Requires an alpha-capable Gecko widget with the Mica pref off.
   Not desktop blur or a compositor capability guarantee; no desktop capture. */
@-moz-document url("chrome://browser/content/browser.xhtml") {
  @media (-moz-platform: windows) and (forced-colors: none) and (-moz-pref("zen.nocturne.home.direct-alpha")) and (not (-moz-pref("zen.nocturne.home.transparent", false))) and (-moz-pref("widget.transparent-windows")) and (not (-moz-pref("widget.windows.mica"))) {
    :root[oneplane-active="true"]:not([customizing], [inDOMFullscreen="true"], [inFullscreen="true"], [popup-window], [zen-before-loaded="true"], [zen-welcome-stage], [zen-private-window="true"], [zen-unsynced-window="true"], [privatebrowsingmode]:not([privatebrowsingmode="false"])):has(#zen-tabbox-wrapper[data-zr-home-host] > #zen-shared-home:not([hidden])) {
      --nocturne-home-alpha-active: 1;
      --nocturne-home-tint-opacity: .65;
      @media (-moz-pref("zen.nocturne.home.tint-opacity", 0)) { --nocturne-home-tint-opacity: 0; }
      @media (-moz-pref("zen.nocturne.home.tint-opacity", 25)) { --nocturne-home-tint-opacity: 0.25; }
      @media (-moz-pref("zen.nocturne.home.tint-opacity", 45)) { --nocturne-home-tint-opacity: 0.45; }
      @media (-moz-pref("zen.nocturne.home.tint-opacity", 85)) { --nocturne-home-tint-opacity: 0.85; }
      @media (-moz-pref("zen.nocturne.home.tint-opacity", 100)) { --nocturne-home-tint-opacity: 1; }
      appearance: none !important;
      background: transparent !important;
      --zen-themed-toolbar-bg-transparent: transparent !important;
      & :is(body, #zen-main-app-wrapper, #browser, #appcontent, #zen-tabbox-wrapper, #tabbrowser-tabbox) {
        background: transparent !important;
      }
      & #zen-browser-background {
        opacity: var(--nocturne-home-tint-opacity) !important;
      }
    }
  }
}
/* OnePlane — native toolbar tab view. No fixed-position overlay. */
 #oneplane-compact-search, #oneplane-hub-button, #oneplane-history-button, #oneplane-download-indicator-slot, #oneplane-tabs, #oneplane-page-actions, #oneplane-url-dismiss, #oneplane-center-start, #oneplane-center-end, #oneplane-toolbar-surface, #oneplane-split-drop { display: none !important; }
@media (min-width: 0px) {
  :root[oneplane-active="true"]:not([customizing], [inDOMFullscreen="true"], [inFullscreen="true"], [popup-window]):has(#nav-bar-customization-target > #oneplane-tabs[data-ready="true"]) {
    --op-height: 34px;
    --op-window-drag-room: 16px;
    @media(max-width:760px){--op-window-drag-room:4px;}
    @media(max-width:480px){--op-window-drag-room:4px;}
    /* Shared row metrics: adding a row never moves the first row. */
    --op-hover-reserve:18px;
    --op-hover-bottom-pad:10px;
    --op-lane-inline-pad:1px;
    --op-top-row-height:calc(var(--op-height) + var(--op-hover-reserve));
    --op-control-row-height:calc(var(--op-top-row-height) - var(--op-hover-bottom-pad));
    --op-row-center:calc(var(--op-control-row-height) / 2);
    --op-contour-trim:5px;
    --op-tab: 36px;
    --op-tab-open: 180px;
    --op-url: 180px;
    --op-url-expanded-width: calc(100vw - 220px);
    --op-url-radius: var(--nocturne-glass-radius, 12px);
    --op-url-header-height: calc(var(--op-height) - 4px);
    --op-url-compact-width: var(--op-url);
    --op-url-surface: var(--nocturne-address-paint, light-dark(#e0e4ec, #30343e));
    --op-speed: 160ms;
    --op-tab-speed: 205ms;
    --op-tab-ease: cubic-bezier(.2, .75, .2, 1);
    --op-url-open-speed: 420ms;
    --op-url-close-speed: 380ms;
    --op-url-ease: cubic-bezier(.22, .72, .2, 1);
    --op-panel-open-speed: 300ms;
    --op-panel-close-speed: 420ms;
    --op-panel-travel: 10px;
    --op-panel-ease: cubic-bezier(.22, .72, .2, 1);
    @media (-moz-pref("zen.oneplane.tab-width", 32)) { --op-tab: 32px; }
    @media (-moz-pref("zen.oneplane.tab-width", 44)) { --op-tab: 44px; }
    @media (-moz-pref("zen.oneplane.expanded-tab-width", 140)) { --op-tab-open: 140px; }
    @media (-moz-pref("zen.oneplane.expanded-tab-width", 240)) { --op-tab-open: 240px; }
    @media (-moz-pref("zen.oneplane.address-width", 140)) { --op-url: 140px; }
    @media (-moz-pref("zen.oneplane.address-width", 220)) { --op-url: 220px; }
    @media (-moz-pref("zen.oneplane.animation-duration", 0)) {
      --op-speed: 0ms; --op-tab-speed: 0ms;
      --op-url-open-speed: 0ms; --op-url-close-speed: 0ms;
      --op-panel-open-speed: 0ms; --op-panel-close-speed: 0ms;
    }
    @media (-moz-pref("zen.oneplane.animation-duration", 100)) { --op-speed: 100ms; --op-tab-speed: 160ms; }
    @media (-moz-pref("zen.oneplane.animation-duration", 250)) { --op-speed: 250ms; --op-tab-speed: 300ms; }
    @media (-moz-pref("zen.nocturne.motion.enabled", false)) {
      --op-speed: 0ms; --op-tab-speed: 0ms;
      --op-url-open-speed: 0ms; --op-url-close-speed: 0ms;
      --op-panel-open-speed: 0ms; --op-panel-close-speed: 0ms;
    }

    /* Keep the original tab model and native sidebar DOM intact. */
    #navigator-toolbox {
      position: fixed !important;
      inset: 0 auto auto 0 !important;
      width: 1px !important;
      height: 1px !important;
      min-width: 0 !important;
      min-height: 0 !important;
      max-width: 1px !important;
      max-height: 1px !important;
      padding: 0 !important;
      margin: 0 !important;
      overflow: hidden !important;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      translate: none !important;
    }
    #zen-sidebar-splitter { display: none !important; }

    #nav-bar {
      overflow:visible!important;
      min-height:var(--op-top-row-height) !important;
    }
    #nav-bar-customization-target {
      min-height:var(--op-top-row-height) !important;
      display: flex !important;
      align-items: center !important;
      min-width: 0 !important;
      overflow: visible !important;
    }
    /* Three zones: left navigation, truly centered tabs, right page/window controls. */
    #nav-bar-customization-target > * { order: 100 !important; }
    #nav-bar-customization-target > toolbarspring { display: none !important; }
    #zen-toggle-compact-mode { display:none !important; }
    #nav-bar-customization-target > #oneplane-hub-button {
      display:flex !important; align-items:center !important; justify-content:center !important;
      order:-3 !important; flex:0 0 30px !important;
      width:30px !important; min-width:30px !important; height:30px !important;
      box-sizing:border-box !important; margin:0 0 0 4px !important;
      padding:0 !important; border:0 !important;
      border-radius:var(--toolbarbutton-border-radius,var(--op-url-radius)) !important;
      color:var(--toolbarbutton-icon-fill,currentColor) !important;
      background-color:transparent !important;
      appearance:none !important; cursor:pointer;
      -moz-window-dragging:no-drag !important;
      pointer-events:auto !important;
    }
    #nav-bar-customization-target > #oneplane-hub-button > svg {
      display:block !important; flex:none !important;
      width:var(--zen-toolbar-button-size,16px) !important; height:var(--zen-toolbar-button-size,16px) !important;
      fill:none !important; stroke:currentColor !important; stroke-width:1.5;
      stroke-linecap:round; stroke-linejoin:round; pointer-events:none !important;
      opacity:.66 !important;
    }
    #nav-bar-customization-target > #oneplane-hub-button:is(:hover,[aria-expanded="true"]) {
      background-color:var(--toolbarbutton-hover-background,color-mix(in srgb,currentColor 12%,transparent)) !important;
    }
    #nav-bar-customization-target > #oneplane-hub-button:active {
      background-color:var(--toolbarbutton-active-background,color-mix(in srgb,currentColor 20%,transparent)) !important;
    }
    #oneplane-hub-button:focus-visible {outline:2px solid AccentColor;outline-offset:-2px;}
    /* History occupies a real first-row slot between Hub and Downloads. */
    #nav-bar-customization-target > #oneplane-history-button {
      display:flex !important; align-items:center !important; justify-content:center !important;
      order:-2 !important; flex:0 0 30px !important;
      width:30px !important; min-width:30px !important; height:30px !important;
      box-sizing:border-box !important; margin:0 !important;
      padding:0 !important; border:0 !important;
      border-radius:var(--toolbarbutton-border-radius,var(--op-url-radius)) !important;
      color:var(--toolbarbutton-icon-fill,currentColor) !important;
      background-color:transparent !important;
      appearance:none !important; cursor:pointer;
      -moz-window-dragging:no-drag !important;
      pointer-events:auto !important;
    }
    #nav-bar-customization-target > #oneplane-history-button > svg {
      display:block !important; flex:none !important;
      width:var(--zen-toolbar-button-size,16px) !important; height:var(--zen-toolbar-button-size,16px) !important;
      fill:none !important; stroke:currentColor !important; stroke-width:1.5;
      stroke-linecap:round; stroke-linejoin:round; pointer-events:none !important;
      opacity:.66 !important;
    }
    #nav-bar-customization-target > #oneplane-history-button:hover {
      background-color:var(--toolbarbutton-hover-background,color-mix(in srgb,currentColor 12%,transparent)) !important;
    }
    #nav-bar-customization-target > #oneplane-history-button:active {
      background-color:var(--toolbarbutton-active-background,color-mix(in srgb,currentColor 20%,transparent)) !important;
    }
    #oneplane-history-button:focus-visible {outline:2px solid AccentColor;outline-offset:-2px;}
    #nav-bar-customization-target > :is(#sidebar-button, #sidebar-toggle-button) { order: 0 !important; }
    #nav-bar-customization-target > #oneplane-download-indicator-slot:has(> #zr-download-indicator) {
      display:flex !important; order:-1 !important;
      flex:0 0 30px !important; width:30px !important; min-width:30px !important;
      height:30px !important; align-items:center; justify-content:center;
      padding:0 !important; margin:0 !important; box-sizing:border-box;
      -moz-window-dragging:no-drag !important;
    }
    #nav-bar-customization-target > #oneplane-center-start { order: 35 !important; }
    #nav-bar-customization-target > #back-button { order: 20 !important; }
    #nav-bar-customization-target > #forward-button { order: 21 !important; }
    #nav-bar-customization-target > :is(#stop-reload-button, #reload-button) { order: 22 !important; }
    #nav-bar-customization-target > #home-button { order: 23 !important; }
    #nav-bar-customization-target > :is(#back-button, #forward-button, #stop-reload-button, #reload-button, #home-button) {
      margin-inline: 0 !important;
      flex: 0 0 auto !important;
    }
    #nav-bar-customization-target > #urlbar-container { order: 30 !important; }
    #nav-bar-customization-target > #oneplane-tabs { order: 40 !important; }
    #nav-bar-customization-target > #oneplane-center-end { order: 50 !important; }
    #nav-bar-customization-target > #oneplane-page-actions { order: 110 !important; }
    #oneplane-center-start, #oneplane-center-end {
      display: block !important;
      flex: 1 1 calc(var(--op-center-bias, 0px) + var(--op-window-drag-room)) !important;
      width: 0;
      min-width: var(--op-window-drag-room);
      height: var(--op-height);
      align-self:center;
      pointer-events: auto;
      -moz-window-dragging: drag !important;
    }
    /* Native drag regions do not follow opacity or pointer-events.
       A collapsed translated toolbar must not contribute hidden handles.
       Default preserves the native thin reveal/caption region. */
    &[zen-compact-mode="true"] #zen-appcontent-navbar-wrapper:not([data-op-panel-open]) :is(#oneplane-center-start,#oneplane-center-end) {
      -moz-window-dragging: default !important;
    }
    /* Keep controls and native popups out of the non-client hit region. */
    #nav-bar-customization-target > :not(#oneplane-center-start,#oneplane-center-end):not(#oneplane-tabs),
    #nav-bar :is(toolbarbutton,button,input,menupopup,panel,.titlebar-buttonbox) {
      -moz-window-dragging: no-drag !important;
    }
    #PersonalToolbar #personal-bookmarks, #PersonalToolbar #PlacesToolbar {
      flex: 1 1 auto !important;
      min-width: 0 !important;
    }
    #PersonalToolbar #PlacesToolbarItems {
      justify-content: center !important;
      flex: 1 1 auto !important;
    }
    /* Keep native captions and the essential navigation controls reachable.
       Additional toolbar widgets remain in their native toolbar and are
       available through the browser menu/extension panel in narrow mode. */
    @media(max-width:700px){
      #nav-bar-customization-target > :is(#sidebar-button,#sidebar-toggle-button,#forward-button,#home-button) {display:none!important;}
      #nav-bar-customization-target > toolbarbutton:not(#back-button,#stop-reload-button,#reload-button,#unified-extensions-button,#PanelUI-menu-button,#nav-bar-overflow-button) {display:none!important;}
    }
    @media(max-width:520px){
      #nav-bar-customization-target > :is(#stop-reload-button,#reload-button,#unified-extensions-button,#nav-bar-overflow-button) {display:none!important;}
      #nav-bar .titlebar-buttonbox > toolbarbutton {min-width:28px!important;width:28px!important;padding-inline:0!important;}
    }
    @media(max-width:400px){
      #nav-bar-customization-target > #back-button {display:none!important;}
    }
    /* All resting controls share the tab lane's center, not the center of
       its hover reserve. The second row adds reserve only below row one. */
    #nav-bar {
      --op-overflow-extra:0px;
      --op-control-bottom-reserve:calc(var(--op-hover-bottom-pad) + var(--op-overflow-extra));
    }
    #nav-bar:has(#oneplane-tabs[data-op-overflow-row]){
      --op-overflow-extra:var(--op-top-row-height);
      min-height:calc(2 * var(--op-top-row-height))!important;
    }
    #nav-bar #nav-bar-customization-target > :not(#oneplane-tabs),
    #nav-bar > :not(#nav-bar-customization-target):not(:has(#nav-bar-customization-target)):not([data-zr-native-captions],.titlebar-buttonbox-container) {
      align-self:center!important;
      margin-block:0 var(--op-control-bottom-reserve)!important;
    }
