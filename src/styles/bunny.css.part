/* OnePlane's single in-window drag card. Outside the window Gecko owns the image. */
:root[oneplane-active="true"] .oneplane-bunny-ghost {
  position: fixed !important;
  z-index: 2147483647 !important;
  pointer-events: none !important;
  transform: translate(-50%,-50%);
  margin: 0 !important;
  padding: 0 !important;
}
:root[oneplane-active="true"] .oneplane-bunny-ghost[hidden] { display:none !important; }
:root[oneplane-active="true"] .oneplane-bunny-card {
  display:flex;
  align-items:center;
  justify-content:center;
  gap:5px;
  min-width:42px;
  height:39px;
  padding:0 8px;
  box-sizing:border-box;
  border:1px solid light-dark(#929bad,#939bad);
  border-radius:7px;
  background:light-dark(#dce1ed,#424653);
  color:light-dark(#151923,#f1f3f8);
  box-shadow:0 8px 19px #0008;
  opacity:1 !important;
  transform-origin:center;
}
:root[oneplane-active="true"] .oneplane-bunny-icon {
  display:grid; place-items:center; width:23px; height:23px;
  opacity:1 !important; filter:none !important;
}
:root[oneplane-active="true"] .oneplane-bunny-icon img {
  width:21px;height:21px;object-fit:contain;opacity:1 !important;filter:none !important;
}

/* The detached Split View ghost uses the same compact geometry and accent
   as its toolbar group, including the six-dot handle and individual cards. */
:root[oneplane-active="true"] .oneplane-bunny-card[data-op-bunny-group] {
  min-width:0; height:var(--op-bunny-height,34px); padding:2px 3px; gap:3px;
  border:0; border-radius:8px;
  background:color-mix(in srgb,var(--op-bunny-accent) 13%,light-dark(#e9edf5,#222631));
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--op-bunny-accent) 75%,transparent),0 8px 19px #0008;
}
:root[oneplane-active="true"] .oneplane-bunny-card[data-op-bunny-group][data-op-bunny-active] {
  background:color-mix(in srgb,var(--op-bunny-accent) 24%,light-dark(#e9edf5,#222631));
  box-shadow:inset 0 0 0 1px var(--op-bunny-accent),0 8px 19px #0008;
}
:root[oneplane-active="true"] .oneplane-bunny-handle {
  display:grid; flex:0 0 16px; width:16px;
  height:calc(var(--op-bunny-height,34px) - 8px);
  grid-template-columns:repeat(2,3px);grid-template-rows:repeat(3,3px);
  place-content:center;gap:2px;border-radius:4px;
  color:var(--op-bunny-accent);background:color-mix(in srgb,var(--op-bunny-accent) 15%,transparent);
}
:root[oneplane-active="true"] .oneplane-bunny-handle i {
  width:3px;height:3px;border-radius:50%;background:currentColor;
}
:root[oneplane-active="true"] .oneplane-bunny-member {
  display:grid;place-items:center;
  width:var(--op-bunny-tab-width,36px);flex:0 0 var(--op-bunny-tab-width,36px);
  height:calc(var(--op-bunny-height,34px) - 8px);border-radius:5px;
  background:color-mix(in srgb,currentColor 11%,transparent);
}
:root[oneplane-active="true"] .oneplane-bunny-member[data-op-bunny-selected] {
  background:color-mix(in srgb,var(--op-bunny-accent) 33%,transparent);
}
:root[oneplane-active="true"] .oneplane-bunny-member .oneplane-bunny-icon,
:root[oneplane-active="true"] .oneplane-bunny-member .oneplane-bunny-icon img {
  width:16px;height:16px;
}

/* The ghost inherits the same unloaded icon state for single tabs and group members. */
:root[oneplane-active="true"] .oneplane-bunny-icon[data-op-bunny-unloaded] {
  opacity: .5 !important;
  filter: grayscale(.5) !important;
}
