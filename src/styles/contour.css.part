    /* Unified contour mask: a solid rounded shelf and one vertical
       rear fade, with opacity applied once to their union. The visual
       surface never enlarges the interactive toolbar or moves controls. */
    #zen-appcontent-navbar-wrapper {
      --op-surface-tint: light-dark(#f4f5f9, #15171e);
      background: transparent !important;
    }
    #zen-appcontent-navbar-wrapper .zen-toolbar-background { display: none !important; }
    #zen-appcontent-navbar-wrapper > #oneplane-toolbar-surface {
      display: block !important;
      height: max(100%, var(--op-measured-toolbar-height, var(--op-height)), var(--op-contour-height, 0px)) !important;
      backdrop-filter: blur(24px) saturate(1.2) !important;
      /* The SVG mask contains the single global opacity. Keep the
         underlying tint solid so it is not multiplied a second time. */
      mask-image: var(--op-contour-mask, linear-gradient(to bottom, rgb(0 0 0 / 96%) 0%, rgb(0 0 0 / 96%) 55%, transparent 100%)) !important;
      mask-mode: alpha !important;
      mask-repeat: no-repeat !important;
      mask-position: top left !important;
      mask-size: 100% var(--op-contour-height, 100%) !important;
      box-shadow: none !important;
      opacity: 0;
      translate: 0 calc(-1 * var(--op-panel-travel));
      transition: opacity var(--op-panel-motion) var(--op-panel-ease),
        translate var(--op-panel-motion) var(--op-panel-ease) !important;
    }
    #zen-appcontent-navbar-wrapper[data-op-panel-open] > #oneplane-toolbar-surface {
      opacity: 1 !important;
      translate: 0 0;
    }
    /* Native Gecko unions drag border boxes and subtracts no-drag
       boxes; an alpha mask or pointer-events:none is not a native
       hit-region boundary. The existing toolbar wrapper is the bounded
       Home handle, never the taller decorative rear fade. */
    #zen-appcontent-navbar-wrapper > #oneplane-toolbar-surface {
      -moz-window-dragging: default !important;
      pointer-events: none !important;
    }
    #zen-appcontent-navbar-wrapper[oneplane-home-hold][data-op-panel-open],
    #zen-appcontent-navbar-wrapper[oneplane-home-hold][data-op-panel-open] :is(#zen-appcontent-navbar-container,#nav-bar,#nav-bar-customization-target,#PersonalToolbar,#personal-bookmarks,#PlacesToolbar,#PlacesToolbarItems) {
      -moz-window-dragging: default !important;
    }
    &:not([data-zr-center-motion],[data-zr-startup-phase],[data-zr-workspace-phase],[data-zr-closing]):not(:has(#zen-shared-home[data-zh-search], #zen-shared-home[data-zh-return], #oneplane-url-dismiss[data-pressed], #oneplane-tabs:is([data-op-dragging],[data-op-lane-drag],[data-op-island-incoming],[data-op-live-drag],[data-op-magnetic-pull],[data-op-cascade]))) #zen-appcontent-navbar-wrapper[oneplane-home-hold][data-op-panel-open]:not(:has(#urlbar[focused="true"], #urlbar[open])) {
      -moz-window-dragging: drag !important;
    }
    #zen-appcontent-navbar-wrapper[oneplane-home-hold] #PersonalToolbar :is(toolbarbutton,button,input,menupopup,panel) {
      -moz-window-dragging: no-drag !important;
    }
    #zen-appcontent-navbar-wrapper > #zen-appcontent-navbar-container {
      opacity: 0 !important;
      translate: 0 calc(-1 * var(--op-panel-travel));
      transition: opacity var(--op-panel-motion) var(--op-panel-ease),
        translate var(--op-panel-motion) var(--op-panel-ease) !important;
      position: relative !important;
      z-index: 1 !important;
    }
    #zen-appcontent-navbar-wrapper[oneplane-startup-hold] > :is(#zen-appcontent-navbar-container, #oneplane-toolbar-surface) {
      transition: none !important;
    }
    #zen-appcontent-navbar-wrapper[data-op-panel-open] > #zen-appcontent-navbar-container {
      opacity:1 !important;
      translate: 0 0;
    }
    #zen-appcontent-navbar-wrapper #nav-bar,
    #zen-appcontent-navbar-wrapper #PersonalToolbar {
      /* Independent row fills/blur would create a hard seam over the mask. */
      background: transparent !important;
      backdrop-filter: none !important;
      box-shadow: none !important;
      border-block-end-color: transparent !important;
    }
    /* The compact backing must be inside the active root scope to
       override the important transparent default. The contour still
       owns the fade below the shelf and bookmarks. */
    #zen-appcontent-navbar-wrapper #nav-bar:has(#oneplane-tabs[data-op-overflow-row]) {
      background:transparent!important;
      background-image:none!important;
    }
    /* Persistent mode: normal flow, same UI, no fade over the page. */
    &:not([zen-compact-mode="true"]) {
      #zen-appcontent-navbar-wrapper {
        position: relative !important;
        inset: auto !important;
        height: auto !important;
        min-height: var(--op-measured-toolbar-height, var(--op-height)) !important;
        flex: 0 0 auto !important;
        transition: none !important;
      }
      #zen-appcontent-navbar-wrapper > #oneplane-toolbar-surface {
        height: 100% !important;
        mask-image: none !important;
        backdrop-filter: none !important;
        opacity: 1 !important;
        translate: none !important;
        transition: none !important;
      }
      #zen-appcontent-navbar-wrapper > #zen-appcontent-navbar-container {
        opacity: 1 !important;
        translate: none !important;
        transition: none !important;
        pointer-events: auto !important;
      }
      #zen-appcontent-navbar-wrapper #urlbar {
        opacity: 1 !important;
        pointer-events: auto !important;
      }
      #zen-appcontent-navbar-wrapper #urlbar-container:is([data-op-empty],[data-op-home]) #urlbar:not([focused="true"], [open], [zen-floating-urlbar="true"]) {
        opacity: 0 !important;
        pointer-events: none !important;
      }
    }
    @media (-moz-pref("zen.nocturne.motion.enabled", false)) {
      #zen-appcontent-navbar-wrapper { transition: none !important; }
    }
    @media (prefers-reduced-transparency: reduce) {
      #zen-appcontent-navbar-wrapper {
        --op-surface-tint: light-dark(#f1f2f5, #1b1d24);
      }
      #zen-appcontent-navbar-wrapper > #oneplane-toolbar-surface {
        mask-image: none !important;
        height: max(100%, var(--op-measured-toolbar-height, var(--op-height))) !important;
        backdrop-filter: none !important;
      }
      #zen-appcontent-navbar-wrapper :is(#nav-bar, #PersonalToolbar) {
        background: var(--op-surface-tint) !important;
      }
    }
  }
}
