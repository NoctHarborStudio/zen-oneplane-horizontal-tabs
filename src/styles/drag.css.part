    #oneplane-tabs[data-op-dragging] .oneplane-split-group[data-op-drag-follow] {
      transition: background-color var(--op-tab-speed) ease, opacity 120ms ease !important;
    }
    /* Pointer-driven squash: the layout slot shrinks with the painted source. */
    #oneplane-tabs[data-op-dragging] [data-op-pulling]:not([data-op-detached]) {
      width: var(--op-pull-width) !important;
      flex: 0 0 var(--op-pull-width) !important;
      min-width: 0 !important;
      max-width: var(--op-pull-width) !important;
      margin-inline-end: var(--op-pull-gap,0px) !important;
      transform: translateX(var(--op-drag-x,0px)) translateY(var(--op-pull-y,0px))
        scaleY(var(--op-pull-scale-y,1)) !important;
