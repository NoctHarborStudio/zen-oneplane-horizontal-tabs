      min-width: 0 !important;
      max-width: 0 !important;
      margin-inline-end: -3px !important;
      padding-inline: 0 !important;
      overflow: hidden !important;
      pointer-events: none !important;
      transition: width var(--op-tab-speed) var(--op-tab-ease),
        flex-basis var(--op-tab-speed) var(--op-tab-ease),
        max-width var(--op-tab-speed) var(--op-tab-ease),
        margin-inline-end var(--op-tab-speed) var(--op-tab-ease),
        padding-inline var(--op-tab-speed) var(--op-tab-ease),
        opacity 100ms ease !important;
    }
    #oneplane-tabs[data-op-dragging] .oneplane-tab[data-op-drag-follow] {
