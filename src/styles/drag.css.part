    }
    /* A single pointer-driven geometry pass positions all neighbors.
       Transitions here would lag behind the moving group and overlap it. */
    #oneplane-tabs[data-op-group-pull] :is(.oneplane-tab-list,.oneplane-island-lane) > :is(.oneplane-tab,.oneplane-split-group),
    #oneplane-tabs[data-op-group-pull] .oneplane-new-tab {
