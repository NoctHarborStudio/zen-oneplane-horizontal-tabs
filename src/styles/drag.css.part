    /* Unloaded tabs stay half-strength throughout pickup and carriage.
       Only the icon is dimmed; the drag card remains opaque. */
    #oneplane-tabs[data-op-dragging] .oneplane-tab[data-unloaded]:not([data-selected])[data-op-drag-follow] .oneplane-tab-icon,
    #oneplane-tabs[data-op-dragging] .oneplane-split-group[data-op-drag-follow] .oneplane-tab[data-unloaded]:not([data-selected]) .oneplane-tab-icon {
