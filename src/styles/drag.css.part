      z-index: 2;
    }
    #oneplane-tabs:not([data-op-dragging]) .oneplane-tab[data-op-hovered]:not([data-op-reinsert]) .oneplane-tab-icon img {
      scale: 1.28;
    }
    /* Split members stay within their shared frame. A small in-frame
       lift and a larger favicon are preferable to stretching the group. */
    #oneplane-tabs:not([data-op-dragging]) .oneplane-split-group .oneplane-tab[data-op-hovered]:not([data-op-reinsert]) {
