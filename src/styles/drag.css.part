    #oneplane-tabs[data-op-dragging] .oneplane-split-group[data-op-drag-follow] .oneplane-tab[data-unloaded]:not([data-selected]) .oneplane-tab-icon {
      opacity: .5 !important;
      filter: grayscale(.5) !important;
