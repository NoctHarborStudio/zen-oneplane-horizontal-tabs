    #oneplane-tabs[data-op-drag-commit] .oneplane-new-tab {
      transition: none !important;
    }
    #oneplane-tabs .oneplane-split-group > .oneplane-tab {
      --op-drag-x: 0px;
      transform: translateX(var(--op-drag-x));
    }
    #oneplane-tabs[data-op-inline-drag] .oneplane-tab-list {
      overflow: visible !important;
    }
    #oneplane-tabs [data-op-drag-follow] {
      position: relative;
      z-index: 12 !important;
      transition: width var(--op-tab-speed) var(--op-tab-ease),
        flex-basis var(--op-tab-speed) var(--op-tab-ease),
        background-color var(--op-tab-speed) ease, opacity 120ms ease !important;
      opacity: 1 !important;
      pointer-events: none !important;
      cursor: grabbing;
    }
    #oneplane-tabs .oneplane-split-group:has([data-op-drag-follow]) { z-index: 11; }
    #oneplane-tabs .oneplane-tab {
      transition: width var(--op-tab-speed) var(--op-tab-ease),
        flex-basis var(--op-tab-speed) var(--op-tab-ease), background-color var(--op-tab-speed) ease,
        transform 170ms cubic-bezier(.22,.72,.2,1), opacity 120ms ease,
        margin-inline-end var(--op-tab-speed) var(--op-tab-ease),
        scale var(--op-tab-speed) var(--op-tab-ease), translate var(--op-tab-speed) var(--op-tab-ease);
    }
    /* The card visibly grows into the spare vertical space of the row.
       Keep horizontal overhang below half the 3px slot gap at every
       supported width, and keep the independent drag transform untouched. */
    #oneplane-tabs .oneplane-tab { scale: 1; translate: 0 0; transform-origin: center; }
    #oneplane-tabs .oneplane-tab-icon img {
      scale: 1;
      transition: scale var(--op-tab-speed) var(--op-tab-ease);
