    }
    @media (prefers-reduced-motion: reduce) {
      #oneplane-tabs .oneplane-tab-icon { transition: none !important; }
    }
    @media (-moz-pref("zen.oneplane.animation-duration", 0)) {
      #oneplane-tabs .oneplane-tab-icon { transition: none !important; }
    }
    /* The slot opens immediately; the card itself springs into it. */
    #oneplane-tabs [data-op-reinsert] {
