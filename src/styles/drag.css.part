/* Slot positions are already calculated by the pointer controller. */
@media (min-width:0px) {
  #oneplane-tabs[data-op-live-drag] :is(.oneplane-tab-list,.oneplane-island-lane) > :is(.oneplane-tab,.oneplane-split-group),
  #oneplane-tabs[data-op-live-drag] .oneplane-new-tab {transition:none !important;}
  #oneplane-tabs[data-op-dragging] [data-op-detached] {opacity:0 !important;visibility:hidden !important;transition:none !important;}
}

/* Magnetic Bunny: native slots stay frozen; only the outer chain on the
   source side translates toward Home. Source occupies its original
   layout width even when detached, preventing flex recentering. */
#oneplane-tabs[data-op-magnetic-pull] :is(.oneplane-tab-list,.oneplane-island-lane) > :is(.oneplane-tab,.oneplane-split-group),
#oneplane-tabs[data-op-magnetic-pull] .oneplane-new-tab {
  transform:translateX(var(--op-bunny-x,0px))!important;
  transition:none!important;
}
#oneplane-tabs[data-op-magnetic-pull] [data-op-magnetic-source] {
  visibility:hidden!important;opacity:0!important;pointer-events:none!important;
  transition:none!important;
}
#oneplane-tabs[data-op-magnetic-pull] #oneplane-tab-indicator {
  opacity:0!important;visibility:hidden!important;transition:none!important;
}

/* An empty native destination has no mirrored slot or fake hitbox. */
#oneplane-tabs[data-op-empty-incoming] .oneplane-new-tab {
  box-shadow:inset 0 0 0 1px var(--zen-primary-color, currentColor)!important;
}
