
/* In-document Hub: manual top layer, no native popup window or screen coordinates. */
#oneplane-hub-panel .op-hub-content {display:flex;flex-direction:column;gap:8px;box-sizing:border-box;width:var(--op-hub-width,250px);max-width:calc(100vw - 8px);max-height:min(560px,calc(100vh - 80px));overflow:auto;padding:10px;color:var(--op-hub-fg,inherit);font:menu;}
#oneplane-hub-panel .op-hub-title {font-size:16px;font-weight:650;margin:0 0 6px;}
#oneplane-hub-panel .op-hub-heading {font-size:11px;font-weight:600;opacity:.7;margin:8px 0 0;}
#oneplane-hub-panel .op-hub-spaces {display:flex;flex-direction:column;gap:3px;}
#oneplane-hub-panel :is(.op-hub-space,.op-hub-mode,.op-hub-add,.op-hub-name) {font:inherit;color:inherit;border:0;border-radius:8px;background:transparent;box-sizing:border-box;min-height:34px;}
#oneplane-hub-panel :is(.op-hub-space,.op-hub-mode,.op-hub-add) {cursor:pointer;padding:7px 9px;text-align:start;}
#oneplane-hub-panel .op-hub-space {display:flex;align-items:center;gap:9px;width:100%;}
#oneplane-hub-panel .op-hub-space[aria-current="true"] {background:color-mix(in srgb,currentColor 12%,transparent);font-weight:600;}
#oneplane-hub-panel :is(.op-hub-space,.op-hub-mode,.op-hub-add):hover:not(:disabled) {background:color-mix(in srgb,currentColor 17%,transparent);}
#oneplane-hub-panel :is(button,input):focus-visible {outline:2px solid AccentColor;outline-offset:-2px;}
#oneplane-hub-panel .op-hub-icon {display:grid;place-items:center;flex:0 0 24px;height:24px;border-radius:6px;background:color-mix(in srgb,currentColor 9%,transparent);}
#oneplane-hub-panel .op-hub-label {flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
#oneplane-hub-panel .op-hub-current {opacity:.7;}
#oneplane-hub-panel .op-hub-create {display:flex;gap:5px;}
#oneplane-hub-panel .op-hub-create[hidden] {display:none!important;}
#oneplane-hub-panel .op-hub-name {flex:1;min-width:0;padding:7px 9px;background:color-mix(in srgb,currentColor 7%,transparent);}
#oneplane-hub-panel .op-hub-add {flex:0 0 34px;text-align:center;font-size:17px;}
#oneplane-hub-panel .op-hub-empty {font-size:12px;opacity:.65;margin:4px 0;}
#oneplane-hub-panel .op-hub-status:empty {display:none;}
#oneplane-hub-panel .op-hub-status {font-size:12px;}
#oneplane-hub-panel .op-hub-mode {width:100%;}
#oneplane-hub-panel button:disabled {opacity:.5;cursor:default;}

#oneplane-hub-panel {
  position:fixed !important;
  inset:var(--op-hub-top,40px) auto auto var(--op-hub-left,4px) !important;
  margin:0 !important; padding:0 !important; border:0 !important;
  border-radius:8px !important;
  clip-path:inset(0 0 0% 0 round 8px);
  width:var(--op-hub-width,250px) !important;
  max-width:calc(100vw - 8px) !important;
  max-height:calc(100vh - var(--op-hub-top,40px) - 8px) !important;
  box-sizing:border-box !important;
  background:var(--op-hub-bg,light-dark(#f4f5f9,#15171e)) !important;
  color:var(--op-hub-fg,CanvasText) !important;
  box-shadow:0 0 0 1px color-mix(in srgb,currentColor 12%,transparent),0 6px 20px #0003;
  overflow:auto !important;
  pointer-events:auto !important;
  -moz-window-dragging:no-drag !important;
  z-index:2147483647 !important;
}
#oneplane-hub-panel[hidden] {display:none !important;}
#oneplane-hub-panel::backdrop {background:transparent;pointer-events:none;}
#oneplane-hub-panel .op-hub-content {width:100%;background:transparent;border-radius:8px;max-height:none;overflow:visible;}
#oneplane-hub-panel * {-moz-window-dragging:no-drag !important;}
#oneplane-hub-panel .op-hub-name {outline:none;box-shadow:none;}
#oneplane-hub-panel .op-hub-name:focus-visible {outline:2px solid AccentColor;outline-offset:-2px;}
#oneplane-hub-panel .op-hub-context {display:flex;flex-direction:column;gap:4px;box-sizing:border-box;width:100%;padding:5px 9px;margin:0 auto;}
#oneplane-hub-panel .op-hub-delete {display:block;width:100%;text-align:center;color:inherit;background:color-mix(in srgb,currentColor 8%,transparent);border:0;border-radius:6px;padding:7px;font:inherit;cursor:pointer;}
#oneplane-hub-panel .op-hub-delete:hover:not(:disabled) {background:color-mix(in srgb,currentColor 16%,transparent);}

#oneplane-hub-panel .op-hub-action,#oneplane-hub-panel .op-hub-return {display:block;box-sizing:border-box;width:100%;text-align:center;color:inherit;background:color-mix(in srgb,currentColor 8%,transparent);border:0;border-radius:6px;padding:7px;font:inherit;cursor:pointer;}
#oneplane-hub-panel .op-hub-action:hover:not(:disabled),#oneplane-hub-panel .op-hub-return:hover:not(:disabled) {background:color-mix(in srgb,currentColor 16%,transparent);}
#oneplane-hub-panel .op-hub-return[hidden] {display:none!important;}
#oneplane-hub-panel .op-hub-confirm-text {margin:4px 0;text-align:center;font-size:12px;line-height:1.4;overflow-wrap:anywhere;}
#oneplane-hub-panel .op-hub-confirm-controls {display:flex;gap:6px;}
#oneplane-hub-panel .op-hub-confirm-controls > button {flex:1;min-width:0;}
#oneplane-hub-panel .op-hub-space[data-op-dragging] {opacity:.65;cursor:grabbing;}
#oneplane-hub-panel[inert] {pointer-events:none!important;}

/* Compact source-window placement diagram. Never a desktop-sized popup. */
#oneplane-placement-preview {position:fixed!important;inset:48px 16px auto auto!important;margin:0!important;display:flex;align-items:center;flex-direction:column;gap:7px;padding:10px!important;width:max-content;max-width:230px;box-sizing:border-box;color:light-dark(#262933,#e1e5ee);background:light-dark(#edf0f6,#252934);border:1px solid color-mix(in srgb,currentColor 22%,transparent);border-radius:9px;box-shadow:0 4px 16px #0003;z-index:2147483647;pointer-events:none!important;}
#oneplane-placement-preview[hidden] {display:none!important;}
#oneplane-placement-preview::backdrop {background:transparent;pointer-events:none;}
#oneplane-placement-preview .op-placement-map {position:relative;overflow:hidden;box-sizing:content-box;background:color-mix(in srgb,currentColor 8%,transparent);outline:1px solid color-mix(in srgb,currentColor 30%,transparent);border-radius:3px;}
#oneplane-placement-preview .op-placement-area {position:absolute;box-sizing:border-box;background:#769ef244;border:1px solid #91adf2;border-radius:2px;}
#oneplane-placement-preview .op-placement-label {font:500 11px system-ui;text-align:center;overflow-wrap:anywhere;}
#oneplane-hub-panel .op-hub-space[data-op-dragging] {background:color-mix(in srgb,currentColor 18%,transparent);outline:1px solid color-mix(in srgb,currentColor 35%,transparent);}

#oneplane-workspace-drag-badge {position:fixed!important;inset:0 auto auto 0!important;margin:0!important;box-sizing:border-box;max-width:160px;padding:9px 13px;border-radius:8px;border:1px solid color-mix(in srgb,currentColor 35%,transparent);background:light-dark(#e9edf5,#353946);color:light-dark(#24262e,#edf0f6);box-shadow:0 4px 14px #0004;pointer-events:none!important;z-index:2147483647;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;font:600 13px system-ui;}
#oneplane-workspace-drag-badge[hidden] {display:none!important;}
#oneplane-workspace-drag-badge::backdrop {pointer-events:none;background:transparent;}
