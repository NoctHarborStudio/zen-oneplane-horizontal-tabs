
/* In-document Hub: manual top layer, no native popup window or screen coordinates. */
#oneplane-hub-panel .op-hub-content {display:flex;flex-direction:column;gap:8px;box-sizing:border-box;width:var(--op-hub-width,250px);max-width:calc(100vw - 8px);max-height:min(560px,calc(100vh - 80px));overflow:auto;padding:10px;color:var(--op-hub-fg,inherit);font:menu;}
#oneplane-hub-panel .op-hub-title {font-size:16px;font-weight:650;margin:0 0 6px;}
#oneplane-hub-panel .op-hub-heading {font-size:11px;font-weight:600;opacity:.7;margin:8px 0 0;}
#oneplane-hub-panel .op-hub-spaces {display:flex;flex-direction:column;gap:3px;}
#oneplane-hub-panel :is(.op-hub-space,.op-hub-mode,.op-hub-add,.op-hub-name) {font:inherit;color:inherit;border:0;border-radius:8px;background:transparent;box-sizing:border-box;min-height:34px;}
#oneplane-hub-panel :is(.op-hub-space,.op-hub-mode,.op-hub-add) {cursor:pointer;padding:7px 9px;text-align:start;}
#oneplane-hub-panel .op-hub-space {display:flex;align-items:center;gap:9px;width:100%;}
#oneplane-hub-panel .op-hub-space[aria-current="true"] {background:color-mix(in srgb,currentColor 12%,transparent);font-weight:600;}
#oneplane-hub-panel :is(.op-hub-space,.op-hub-mode,.op-hub-add):hover:not(:disabled) {background:color-mix(in srgb,currentColor 17%,transparent);}
#oneplane-hub-panel :is(button,input):focus-visible {outline:2px solid AccentColor;outline-offset:-2px;}
#oneplane-hub-panel .op-hub-icon {display:grid;place-items:center;flex:0 0 24px;height:24px;border-radius:6px;background:color-mix(in srgb,currentColor 9%,transparent);}
#oneplane-hub-panel .op-hub-label {flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
#oneplane-hub-panel .op-hub-current {opacity:.7;}
#oneplane-hub-panel .op-hub-create {display:flex;gap:5px;}
#oneplane-hub-panel .op-hub-create[hidden] {display:none!important;}
#oneplane-hub-panel .op-hub-name {flex:1;min-width:0;padding:7px 9px;background:color-mix(in srgb,currentColor 7%,transparent);}
#oneplane-hub-panel .op-hub-add {flex:0 0 34px;text-align:center;font-size:17px;}
#oneplane-hub-panel .op-hub-empty {font-size:12px;opacity:.65;margin:4px 0;}
#oneplane-hub-panel .op-hub-status:empty {display:none;}
#oneplane-hub-panel .op-hub-status {font-size:12px;}
#oneplane-hub-panel .op-hub-mode {width:100%;}
#oneplane-hub-panel button:disabled {opacity:.5;cursor:default;}

#oneplane-hub-panel {
  position:fixed !important;
  inset:var(--op-hub-top,40px) auto auto var(--op-hub-left,4px) !important;
  margin:0 !important; padding:0 !important; border:0 !important;
  border-radius:8px !important;
  clip-path:inset(0 0 0% 0 round 8px);
  width:var(--op-hub-width,250px) !important;
  max-width:calc(100vw - 8px) !important;
  max-height:calc(100vh - var(--op-hub-top,40px) - 8px) !important;
  box-sizing:border-box !important;
  background:var(--op-hub-bg,light-dark(#f4f5f9,#15171e)) !important;
  color:var(--op-hub-fg,CanvasText) !important;
  box-shadow:0 0 0 1px color-mix(in srgb,currentColor 12%,transparent),0 6px 20px #0003;
  overflow:auto !important;
  pointer-events:auto !important;
  -moz-window-dragging:no-drag !important;
  z-index:2147483647 !important;
}
#oneplane-hub-panel[hidden] {display:none !important;}
#oneplane-hub-panel::backdrop {background:transparent;pointer-events:none;}
#oneplane-hub-panel .op-hub-content {width:100%;background:transparent;border-radius:8px;max-height:none;overflow:visible;}
#oneplane-hub-panel * {-moz-window-dragging:no-drag !important;}
#oneplane-hub-panel .op-hub-name {outline:none;box-shadow:none;}
#oneplane-hub-panel .op-hub-name:focus-visible {outline:2px solid AccentColor;outline-offset:-2px;}
#oneplane-hub-panel .op-hub-context {display:flex;flex-direction:column;gap:4px;box-sizing:border-box;width:100%;padding:5px 9px;margin:0 auto;}
#oneplane-hub-panel .op-hub-delete {display:block;width:100%;text-align:center;color:inherit;background:color-mix(in srgb,currentColor 8%,transparent);border:0;border-radius:6px;padding:7px;font:inherit;cursor:pointer;}
#oneplane-hub-panel .op-hub-delete:hover:not(:disabled) {background:color-mix(in srgb,currentColor 16%,transparent);}

#oneplane-hub-panel .op-hub-action,#oneplane-hub-panel .op-hub-return {display:block;box-sizing:border-box;width:100%;text-align:center;color:inherit;background:color-mix(in srgb,currentColor 8%,transparent);border:0;border-radius:6px;padding:7px;font:inherit;cursor:pointer;}
#oneplane-hub-panel .op-hub-action:hover:not(:disabled),#oneplane-hub-panel .op-hub-return:hover:not(:disabled) {background:color-mix(in srgb,currentColor 16%,transparent);}
#oneplane-hub-panel .op-hub-return[hidden] {display:none!important;}
#oneplane-hub-panel .op-hub-confirm-text {margin:4px 0;text-align:center;font-size:12px;line-height:1.4;overflow-wrap:anywhere;}
#oneplane-hub-panel .op-hub-confirm-controls {display:flex;gap:6px;}
#oneplane-hub-panel .op-hub-confirm-controls > button {flex:1;min-width:0;}
#oneplane-hub-panel .op-hub-space[data-op-dragging] {opacity:.65;cursor:grabbing;}
#oneplane-hub-panel[inert] {pointer-events:none!important;}

/* Small target-monitor panel; no full-display XUL surface. */
#oneplane-placement-preview {--panel-padding:0px;--panel-background:transparent;--panel-border-color:transparent;margin:0!important;padding:0!important;background:transparent!important;border:0!important;pointer-events:none!important;}
#oneplane-placement-preview::part(content) {padding:0!important;background:transparent!important;border:0!important;}
#oneplane-placement-preview .op-placement-content {display:flex;align-items:center;flex-direction:column;gap:7px;width:210px;box-sizing:border-box;padding:10px;color:light-dark(#262933,#e1e5ee);background:light-dark(#edf0f6,#252934);border:1px solid color-mix(in srgb,currentColor 22%,transparent);border-radius:9px;pointer-events:none!important;}
#oneplane-placement-preview .op-placement-map {position:relative;overflow:hidden;box-sizing:content-box;background:color-mix(in srgb,currentColor 8%,transparent);outline:1px solid color-mix(in srgb,currentColor 30%,transparent);border-radius:3px;}
#oneplane-placement-preview .op-placement-area {position:absolute;box-sizing:border-box;background:#769ef244;border:1px solid #91adf2;border-radius:2px;}
#oneplane-placement-preview .op-placement-label {font:500 11px system-ui;text-align:center;overflow-wrap:anywhere;}
#oneplane-hub-panel .op-hub-space[data-op-dragging] {background:color-mix(in srgb,currentColor 18%,transparent);outline:1px solid color-mix(in srgb,currentColor 35%,transparent);}

#oneplane-workspace-drag-badge {position:fixed!important;inset:0 auto auto 0!important;margin:0!important;box-sizing:border-box;max-width:160px;padding:9px 13px;border-radius:8px;border:1px solid color-mix(in srgb,currentColor 35%,transparent);background:light-dark(#e9edf5,#353946);color:light-dark(#24262e,#edf0f6);box-shadow:0 4px 14px #0004;pointer-events:none!important;z-index:2147483647;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;font:600 13px system-ui;}
#oneplane-workspace-drag-badge[hidden] {display:none!important;}
#oneplane-workspace-drag-badge::backdrop {pointer-events:none;background:transparent;}

/* Workspace management and expanding Trash button. */
#oneplane-hub-panel .op-hub-title-row {display:flex;align-items:center;margin:2px 0 4px;}
#oneplane-hub-panel .op-hub-title-row .op-hub-title {margin:0;}
#oneplane-hub-panel .op-hub-free-slot {display:flex;flex-direction:column;gap:3px;}
#oneplane-hub-panel .op-hub-free-slot:empty {display:none;}
#oneplane-hub-panel .op-hub-divider {height:1px;background:color-mix(in srgb,currentColor 14%,transparent);margin:2px 2px;}
#oneplane-hub-panel .op-hub-divider[hidden] {display:none;}
#oneplane-hub-panel .op-hub-lock {display:flex;opacity:.65;}
#oneplane-hub-panel .op-hub-lock svg {width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;}
#oneplane-hub-panel .op-hub-icon {color:var(--op-space-accent,inherit);background:color-mix(in srgb,var(--op-space-accent,currentColor) 18%,transparent);}
#oneplane-hub-panel :is(.op-hub-free-setup,.op-hub-edit,.op-hub-trash-confirm,.op-hub-trash-notice) {display:flex;flex-direction:column;gap:6px;}
#oneplane-hub-panel .op-hub-free-setup[hidden] {display:none!important;}
#oneplane-hub-panel .op-hub-mode {display:flex;justify-content:space-between;align-items:center;}
#oneplane-hub-panel .op-hub-mode-state {opacity:.7;}
#oneplane-hub-panel .op-hub-trash-panel {border:1px solid color-mix(in srgb,currentColor 15%,transparent);border-radius:9px;background:color-mix(in srgb,currentColor 5%,transparent);transition:background 300ms,border-color 300ms;margin-top:3px;}
#oneplane-hub-panel .op-hub-trash-panel[data-op-trash-open] {background:color-mix(in srgb,currentColor 7%,transparent);}
#oneplane-hub-panel .op-hub-trash-head {position:relative;height:40px;}
#oneplane-hub-panel .op-hub-trash-toggle {position:absolute;inset:0;width:100%;border:0;border-radius:8px;background:transparent;color:inherit;cursor:pointer;display:flex;align-items:center;justify-content:center;font:inherit;}
#oneplane-hub-panel .op-hub-trash-toggle:hover {background:color-mix(in srgb,currentColor 5%,transparent);}
#oneplane-hub-panel .op-hub-trash-title {position:absolute;inset-inline-start:8px;opacity:0;transform:translateX(-4px);font-weight:600;transition:opacity 200ms,transform 300ms;font-size:11px;}
#oneplane-hub-panel .op-hub-trash-symbol {position:absolute;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:4px;transition:left 400ms cubic-bezier(.22,.75,.22,1),transform 400ms cubic-bezier(.22,.75,.22,1);}
#oneplane-hub-panel .op-hub-trash-toggle svg {width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
#oneplane-hub-panel .op-hub-trash-count {font-size:10px;font-variant-numeric:tabular-nums;border-radius:4px;background:color-mix(in srgb,currentColor 10%,transparent);padding:2px 4px;min-width:15px;text-align:center;}
#oneplane-hub-panel [data-op-trash-open] .op-hub-trash-symbol {left:calc(100% - 7px);transform:translateX(-100%);}
#oneplane-hub-panel [data-op-trash-open] .op-hub-trash-title {opacity:1;transform:translateX(0);}
#oneplane-hub-panel .op-hub-trash-tools {position:absolute;left:50%;top:7px;transform:translate(-50%,-3px);display:flex;align-items:center;gap:3px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 200ms,transform 300ms;}
#oneplane-hub-panel [data-op-trash-open] .op-hub-trash-tools {opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0);transition-delay:130ms;}
#oneplane-hub-panel .op-hub-trash-tools .op-hub-action,#oneplane-hub-panel .op-hub-age {width:auto;height:26px;box-sizing:border-box;padding:3px 5px;font:inherit;font-size:10px;white-space:nowrap;}
#oneplane-hub-panel .op-hub-age {width:72px;min-width:0;max-width:100%;color:inherit;background:var(--op-hub-bg,Canvas);border:1px solid color-mix(in srgb,currentColor 20%,transparent);border-radius:5px;}
#oneplane-hub-panel .op-hub-trash-drawer {display:grid;grid-template-rows:0fr;opacity:0;transition:grid-template-rows 420ms cubic-bezier(.22,.75,.22,1),opacity 280ms;}
#oneplane-hub-panel [data-op-trash-open] .op-hub-trash-drawer {grid-template-rows:1fr;opacity:1;}
#oneplane-hub-panel .op-hub-trash-inner {min-height:0;overflow:hidden;}
#oneplane-hub-panel .op-hub-trash-list {max-height:270px;overflow:auto;padding:0 5px;scrollbar-width:thin;overflow-anchor:none;}
#oneplane-hub-panel .op-hub-trash-list[hidden] {display:none;}
#oneplane-hub-panel .op-hub-trash-rows {box-sizing:content-box;}
#oneplane-hub-panel .op-hub-trash-item {display:flex;align-items:center;gap:7px;height:50px;box-sizing:border-box;margin:0 0 4px;padding:6px;border:1px solid transparent;border-radius:7px;background:color-mix(in srgb,currentColor 6%,transparent);transition:background 200ms,transform 220ms,opacity 200ms;user-select:none;overflow:hidden;}
#oneplane-hub-panel .op-hub-trash-item:hover {background:color-mix(in srgb,currentColor 11%,transparent);}
#oneplane-hub-panel .op-hub-trash-item[draggable="true"] {cursor:grab;}
#oneplane-hub-panel .op-hub-trash-item[draggable="true"]:active {transform:scale(1.025);}
#oneplane-hub-panel .op-hub-trash-item[data-op-trash-dragging] {opacity:.28;transform:scale(.97);}
#oneplane-hub-panel .op-hub-trash-site-icon {display:grid;place-items:center;flex:0 0 22px;height:22px;border-radius:4px;font-size:16px;opacity:.9;}
#oneplane-hub-panel .op-hub-trash-site-icon img {width:18px;height:18px;object-fit:contain;pointer-events:none;}
#oneplane-hub-panel .op-hub-trash-copy {min-width:0;flex:1;display:flex;flex-direction:column;gap:3px;}
#oneplane-hub-panel :is(.op-hub-trash-site-title,.op-hub-trash-url) {white-space:nowrap;text-overflow:ellipsis;overflow:hidden;}
#oneplane-hub-panel .op-hub-trash-site-title {font-size:12px;font-weight:550;}
#oneplane-hub-panel .op-hub-trash-url,#oneplane-hub-panel .op-hub-trash-date {font-size:10px;opacity:.65;}
#oneplane-hub-panel .op-hub-trash-date {white-space:nowrap;font-variant-numeric:tabular-nums;}
#oneplane-hub-panel .op-hub-trash-confirm:not(:empty),#oneplane-hub-panel .op-hub-trash-notice:not(:empty) {padding:4px 7px;}
#oneplane-hub-panel .op-hub-trash-ghost {position:fixed;z-index:2;margin:0;transform:scale(1.04);opacity:1;pointer-events:none;background:var(--op-hub-bg,Canvas);border-color:AccentColor;box-shadow:0 4px 14px #0004;}
#oneplane-hub-panel .op-hub-space[data-op-trash-target] {background:color-mix(in srgb,AccentColor 24%,transparent);outline:1px solid AccentColor;transform:scale(1.015);}
#oneplane-hub-panel .op-hub-color {width:100%;min-height:28px;border:0;background:transparent;}
#oneplane-hub-panel .op-hub-edit .op-hub-name {width:100%;}
/* Keep the fixed Hub width; narrow chrome uses a second header line. */
@container (max-width: 225px) {
  #oneplane-hub-panel [data-op-trash-open] .op-hub-trash-head {height:70px;}
  #oneplane-hub-panel [data-op-trash-open] .op-hub-trash-tools {top:38px;}
  #oneplane-hub-panel [data-op-trash-open] .op-hub-trash-toggle {height:40px;}
}
#oneplane-hub-panel .op-hub-content {container-type:inline-size;}
#oneplane-hub-panel .op-hub-space {transition:background 180ms,transform 220ms;}
@media (prefers-reduced-motion:reduce) {
  #oneplane-hub-panel :is(.op-hub-trash-panel,.op-hub-trash-title,.op-hub-trash-symbol,.op-hub-trash-tools,.op-hub-trash-drawer,.op-hub-trash-item,.op-hub-space) {transition:none!important;}
}
