    /* A real flex wrapper, with one shared surface and a dedicated handle.
       Its 25px overhead is included in collapsed-strip centering. */
    #oneplane-tabs .oneplane-split-group {
      position: relative;
      display: flex;
      --op-split-width: var(--op-split-measured, calc(var(--op-split-members, 2) * (var(--op-tab) + 3px) + 22px));
      flex: 0 0 auto;
      width: max-content;
      min-width: 0;
      align-items: center;
      gap: 3px;
      padding: 2px 3px;
      height: var(--op-height);
      box-sizing: border-box;
      border-radius: 8px !important;
      background: color-mix(in srgb, var(--op-split-color) calc(13% * var(--op-cascade-frame-alpha,1)), transparent);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--op-split-color) calc(75% * var(--op-cascade-frame-alpha,1)), transparent);
      transition: background-color var(--op-tab-speed) ease, box-shadow var(--op-tab-speed) ease;
    }
    #oneplane-tabs .oneplane-split-group[data-op-split-active] {
      background: color-mix(in srgb, var(--op-split-color) calc(24% * var(--op-cascade-frame-alpha,1)), transparent);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--op-split-color) calc(100% * var(--op-cascade-frame-alpha,1)), transparent);
    }
    #oneplane-tabs .oneplane-split-group .oneplane-tab {
      height: calc(var(--op-height) - 8px);
      border-radius: 5px;
      box-shadow: none !important;
    }
    #oneplane-tabs .oneplane-split-group .oneplane-tab[data-selected] {
      background: color-mix(in srgb, var(--op-split-color) 33%, transparent);
    }
    #oneplane-tabs .oneplane-split-group .oneplane-tab[data-op-hovered] {
      background: color-mix(in srgb, var(--op-split-color) 27%, transparent);
    }
    #oneplane-tabs button.oneplane-split-handle {
      flex: 0 0 16px;
      width: 16px;
      height: calc(var(--op-height) - 8px);
      display: grid;
      grid-template-columns: repeat(2, 3px);
      grid-template-rows: repeat(3, 3px);
      place-content: center;
      gap: 2px;
      border-radius: 4px;
      color: var(--op-split-color);
      background: color-mix(in srgb, var(--op-split-color) 15%, transparent);
      cursor: grab;
    }
    #oneplane-tabs button.oneplane-split-handle i {
      width: 3px; height: 3px; border-radius: 50%;
      background: currentColor; pointer-events: none;
    }
    #oneplane-tabs button.oneplane-split-handle:hover {
      background: color-mix(in srgb, var(--op-split-color) 33%, transparent);
    }
    #oneplane-tabs .oneplane-split-group[data-op-group-dragging] { cursor: grabbing; }
    #oneplane-tabs .oneplane-split-group[data-op-group-dragging] .oneplane-split-handle { cursor: grabbing; }
    #oneplane-tabs :is(.oneplane-split-group, .oneplane-tab)[data-op-drop-before] { box-shadow: inset 3px 0 #a9c1ff !important; }
    #oneplane-tabs :is(.oneplane-split-group, .oneplane-tab)[data-op-drop-after] { box-shadow: inset -3px 0 #a9c1ff !important; }

