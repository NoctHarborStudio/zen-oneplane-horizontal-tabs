    #oneplane-tabs[data-op-home-icon] .oneplane-island-title {display:none;}
    #oneplane-tabs[data-op-island-compact]:not([data-op-island-tight]) .oneplane-title-island[data-op-home-enabled] {background:transparent;box-shadow:none;padding:0;}
    #oneplane-tabs[data-op-island-compact] .oneplane-title-island[data-op-home-enabled] > svg {display:block;}
    #oneplane-tabs[data-op-island-compact] .oneplane-title-island[data-op-home-enabled] .oneplane-island-title {display:none;}
