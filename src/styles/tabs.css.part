      --op-expand-left: 0px;
      --op-shift-left: min(var(--op-expand-left), var(--op-left-room, 0px));
      overflow: visible !important;
      position: relative !important;
      flex: 0 1 auto !important;
      min-width: 0 !important;
      width: calc(var(--op-tab-count, 0) * (var(--op-tab) + 3px) + var(--op-split-count, 0) * 25px + var(--op-tab-open) + 3px) !important;
      --op-hover-reserve:18px;
      --op-hover-bottom-pad:10px;
      height: calc(var(--op-height) + var(--op-hover-reserve)) !important;
      min-height: calc(var(--op-height) + var(--op-hover-reserve)) !important;
      align-items: center;
      gap: 3px;
      margin-inline: 2px;
      color: var(--toolbar-color, currentColor);
      -moz-window-dragging: no-drag;
