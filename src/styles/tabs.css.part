    #oneplane-tabs[data-op-small-strip]:has(.oneplane-tab[data-op-last]:not([data-op-first])[data-op-expanded]) {
      --op-expand-left: 0px;
    }
    #oneplane-tabs :is(.oneplane-tab-list, .oneplane-new-tab) {
      translate: calc(-1 * var(--op-shift-left)) 0;
      transition: translate var(--op-tab-speed) var(--op-tab-ease);
    }
    #oneplane-tabs .oneplane-tab-list {
      display: flex;
      flex: 0 1 auto;
      min-width: 0;
      height: 100%;
      align-items: center;
      gap: 3px;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      box-sizing:border-box;
      padding-block-end:var(--op-hover-bottom-pad);
    }
    /* The island and both lanes remain stationary during dragging.
       The native drag controller positions cards in virtual lane slots. */
    #oneplane-tabs .oneplane-island-lane { display: contents; }
    #oneplane-tabs .oneplane-title-island { display: none; }
    #oneplane-tabs[data-op-hover-mode="island"] {
      width: calc(var(--op-tab-count, 0) * (var(--op-tab) + 3px) + var(--op-split-count, 0) * 25px + var(--op-tab)) !important;
    }
    #oneplane-tabs[data-op-show-island]:not([data-op-island-tight]) {
      width: var(--op-island-row-width, 280px) !important;
      flex: 0 0 var(--op-island-row-width, 280px) !important;
    }
    #oneplane-tabs[data-op-show-island]:not([data-op-island-tight]) .oneplane-tab-list {
      display:grid;
      grid-template-columns:minmax(0,1fr) var(--op-island-width,180px) minmax(0,1fr);
      grid-template-rows:minmax(0,1fr);
      column-gap:3px;
      width:100%;
      flex:1 1 100%;
      overflow:visible;
      padding:0;
    }
    #oneplane-tabs[data-op-show-island]:not([data-op-island-tight]) .oneplane-island-lane {
      display:flex;
      align-items:center;
      gap:3px;
      min-width:0;
      height:100%;
      padding:0 3px var(--op-hover-bottom-pad);
      box-sizing:border-box;
      overflow-x:auto;
      overflow-y:hidden;
      overscroll-behavior-x:contain;
      scrollbar-width:thin;
      scrollbar-color:color-mix(in srgb,currentColor 25%,transparent) transparent;
    }
    #oneplane-tabs[data-op-show-island]:not([data-op-island-tight]) .oneplane-island-left {
      grid-column:1;grid-row:1;
      justify-content:safe flex-end;
    }
    #oneplane-tabs[data-op-show-island]:not([data-op-island-tight]) .oneplane-island-right {
