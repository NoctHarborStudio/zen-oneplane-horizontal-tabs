    #oneplane-tabs[data-op-show-island]:not([data-op-island-tight]):not([data-op-dragging],[data-op-island-incoming],[data-op-cascade]) .oneplane-title-island[data-op-home-enabled] {pointer-events:auto;cursor:pointer;}
