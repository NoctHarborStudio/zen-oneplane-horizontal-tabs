      left:50%;top:calc(50% - var(--op-hover-bottom-pad)/2);translate:-50% -50%;
      width:var(--op-island-width,180px);height:calc(var(--op-height) - 6px);
      box-sizing:border-box;padding-inline:10px;
      border-radius:999px;
      background:color-mix(in srgb,currentColor 12%,transparent);
