      align-items: center;
      justify-content: center;
      gap: 0;
      padding-inline: 0;
      overflow: hidden;
      transition: gap var(--op-tab-speed) var(--op-tab-ease), padding var(--op-tab-speed) var(--op-tab-ease);
    }
    #oneplane-tabs .oneplane-tab[data-op-expanded] .oneplane-tab-select {
