    #oneplane-tabs[data-op-show-island]:not([data-op-island-tight],[data-op-overflow-row],[data-op-lane-drag]):is([data-op-dragging],[data-op-island-incoming]) .oneplane-island-lane {
      overflow:visible !important;
    }
    #oneplane-tabs[data-op-show-island]:not([data-op-island-tight]):is([data-op-dragging],[data-op-island-incoming]) .oneplane-tab-list {
