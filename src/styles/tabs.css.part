    }
    #oneplane-tabs[data-op-show-island]:not([data-op-island-tight]):is([data-op-dragging],[data-op-island-incoming]) .oneplane-title-island {
      background:color-mix(in srgb,currentColor 12%,light-dark(#e9edf5,#222631));
    }
    #oneplane-tabs:not([data-op-show-island]) .oneplane-new-tab,
    #oneplane-tabs[data-op-island-tight] .oneplane-new-tab {
      margin-block-end:var(--op-hover-bottom-pad);
    }
    #oneplane-tabs .oneplane-island-title {
      display:block;min-width:0;max-width:100%;white-space:nowrap;
      overflow:hidden;text-overflow:ellipsis;text-align:center;
      font-size:12px;font-weight:500;
    }
    #oneplane-tabs .oneplane-tab {
      position: relative;
      display: flex;
      flex: 0 0 var(--op-tab);
      width: var(--op-tab);
      height: calc(var(--op-height) - 4px);
      align-items: stretch;
      overflow: hidden;
      border-radius: 7px;
      background: color-mix(in srgb, currentColor 11%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 5%, transparent);
      transition: width var(--op-tab-speed) var(--op-tab-ease), flex-basis var(--op-tab-speed) var(--op-tab-ease), background-color var(--op-tab-speed) ease;
    }
    #oneplane-tabs .oneplane-tab[data-op-expanded] {
